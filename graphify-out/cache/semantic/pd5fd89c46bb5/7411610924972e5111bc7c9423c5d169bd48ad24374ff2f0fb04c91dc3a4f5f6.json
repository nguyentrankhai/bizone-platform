{"nodes": [{"id": "documents_srs_paymenthub_payment_hub", "label": "Payment Hub System", "file_type": "document", "source_file": "documents/SRS-PaymentHub.md", "source_location": "\u00a72.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Centralized payment middleware that abstracts multiple PSPs behind a single API. BizOne POS/Website/Mobile call one API instead of integrating each payment partner directly, enabling easier PSP addition."}, {"id": "documents_srs_paymenthub_connector_architecture", "label": "Connector Plugin Architecture", "file_type": "rationale", "source_file": "documents/SRS-PaymentHub.md", "source_location": "\u00a73.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plugin-based design allows adding new PSPs without modifying Core Payment Hub code (zero-core-change). Each Connector implements a standard interface contract; hot-plug enables activation without restart."}, {"id": "documents_srs_paymenthub_connector_registry", "label": "Connector Registry", "file_type": "concept", "source_file": "documents/SRS-PaymentHub.md", "source_location": "\u00a73.3.4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "documents_srs_paymenthub_connector_interface", "label": "PaymentConnector Interface Contract", "file_type": "concept", "source_file": "documents/SRS-PaymentHub.md", "source_location": "\u00a73.3.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "documents_srs_paymenthub_mapping_layer", "label": "Connector Mapping Layer (DTO)", "file_type": "concept", "source_file": "documents/SRS-PaymentHub.md", "source_location": "\u00a73.3.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "documents_srs_paymenthub_circuit_breaker", "label": "Circuit Breaker (Payment Hub)", "file_type": "concept", "source_file": "documents/SRS-PaymentHub.md", "source_locati