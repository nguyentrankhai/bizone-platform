/// P4.4: one row per automatic promotion applied on an invoice (flash sale units, buy-X-get-Y
/// gifts, combo sets) — undone when the invoice is cancelled, read by the marketing report.
model PromotionUsage {
  id             Int                @id @default(autoincrement())
  promotionType  PromotionUsageType @map("promotion_type")
  /// flash_sales.id / promotion_buy_x_get_y.id / promotion_combos.id
  promotionId    Int                @map("promotion_id")
  /// flash_sale_products.id for a flash sale line
  itemRefId      Int?               @map("item_ref_id")
  invoiceId      Int                @map("invoice_id")
  customerId     Int?               @map("customer_id")
  productId      Int?               @map("product_id")
  /// units at flash price / gift units / combo sets
  quantity       Int
  discountAmount Decimal            @map("discount_amount") @db.Decimal(15, 2)
  usedAt         DateTime           @default(now()) @map("used_at") @db.DateTime(0)
  invoice        Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_pu_invoice")
  customer       Customer?          @relation(fields: [customerId], references: [id], onUpdate: Restrict, map: "fk_pu_customer")

  @@index([promotionType, promotionId], map: "idx_pu_promotion")
  @@index([invoiceId], map: "idx_pu_invoice")
  @@index([customerId], map: "fk_pu_customer")
  @@index([usedAt], map: "idx_pu_used")
  @@map("promotion_usage")
}

enum PromotionUsageType {
  flash_sale
  buy_x_get_y
  combo
}
