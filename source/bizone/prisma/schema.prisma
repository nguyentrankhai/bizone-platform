generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Attendance {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  date      DateTime         @db.Date
  checkIn   DateTime?        @map("check_in") @db.DateTime(0)
  checkOut  DateTime?        @map("check_out") @db.DateTime(0)
  status    AttendanceStatus @default(present)
  notes     String?          @db.Text
  createdAt DateTime         @default(now()) @map("created_at") @db.DateTime(0)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_att_user")

  @@unique([userId, date], map: "uq_attendance")
  @@index([date], map: "idx_att_date")
  @@index([userId], map: "idx_att_user")
  @@map("attendance")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     Int?     @map("user_id")
  action     String   @db.VarChar(50)
  module     String   @db.VarChar(50)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   Int?     @map("entity_id")
  oldValue   String?  @map("old_value") @db.Text
  newValue   String?  @map("new_value") @db.Text
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text
  notes      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(0)
  user       User?    @relation(fields: [userId], references: [id], onUpdate: Restrict, map: "fk_al_user")

  @@index([userId], map: "fk_al_user")
  @@index([action], map: "idx_audit_action")
  @@index([createdAt], map: "idx_audit_created")
  @@index([entityType, entityId], map: "idx_audit_entity")
  @@index([module], map: "idx_audit_module")
  @@map("audit_logs")
}

model Branch {
  id                    Int                    @id @default(autoincrement())
  name                  String                 @db.VarChar(255)
  code                  String                 @unique(map: "code") @db.VarChar(50)
  address               String?                @db.Text
  phone                 String?                @db.VarChar(20)
  email                 String?                @db.VarChar(255)
  taxCode               String?                @map("tax_code") @db.VarChar(50)
  status                BranchStatus           @default(active)
  isDefault             Boolean                @default(false) @map("is_default")
  createdAt             DateTime               @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  cashFunds             CashFund[]
  cashSessions          CashSession[]
  invoices              Invoice[]
  orders                Order[]
  purchaseOrders        PurchaseOrder[]
  revenueExpenseRecords RevenueExpenseRecord[]
  shifts                Shift[]
  userBranches          UserBranch[]
  userRoles             UserRole[]
  warehouses            Warehouse[]

  @@map("branches")
}

model CashFund {
  id                    Int                    @id @default(autoincrement())
  branchId              Int?                   @map("branch_id")
  name                  String                 @db.VarChar(255)
  code                  String                 @unique(map: "code") @db.VarChar(50)
  balance               Decimal                @default(0.00) @db.Decimal(15, 2)
  isActive              Boolean                @default(true) @map("is_active")
  createdAt             DateTime               @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  branch                Branch?                @relation(fields: [branchId], references: [id], onUpdate: Restrict, map: "fk_cf_branch")
  fundTransactions      FundTransaction[]
  revenueExpenseRecords RevenueExpenseRecord[]

  @@index([branchId], map: "fk_cf_branch")
  @@map("cash_funds")
}

model CashSession {
  id                   Int               @id @default(autoincrement())
  branchId             Int               @map("branch_id")
  userId               Int               @map("user_id")
  openedAt             DateTime          @default(now()) @map("opened_at") @db.DateTime(0)
  closedAt             DateTime?         @map("closed_at") @db.DateTime(0)
  openingBalance       Decimal           @default(0.00) @map("opening_balance") @db.Decimal(15, 2)
  closingBalance       Decimal?          @map("closing_balance") @db.Decimal(15, 2)
  actualClosingBalance Decimal?          @map("actual_closing_balance") @db.Decimal(15, 2)
  difference           Decimal?          @db.Decimal(15, 2)
  notes                String?           @db.Text
  status               CashSessionStatus @default(open)
  branch               Branch            @relation(fields: [branchId], references: [id], onUpdate: Restrict, map: "fk_cs_branch")
  user                 User              @relation(fields: [userId], references: [id], onUpdate: Restrict, map: "fk_cs_user")
  invoices             Invoice[]

  @@index([branchId], map: "idx_cs_branch")
  @@index([status], map: "idx_cs_status")
  @@index([userId], map: "idx_cs_user")
  @@map("cash_sessions")
}

model ChannelConnection {
  id                    Int                     @id @default(autoincrement())
  channelCode           String                  @map("channel_code") @db.VarChar(50)
  channelName           String                  @map("channel_name") @db.VarChar(255)
  accessToken           String?                 @map("access_token") @db.Text
  refreshToken          String?                 @map("refresh_token") @db.Text
  tokenExpiresAt        DateTime?               @map("token_expires_at") @db.DateTime(0)
  shopId                String?                 @map("shop_id") @db.VarChar(100)
  isActive              Boolean                 @default(true) @map("is_active")
  lastSyncAt            DateTime?               @map("last_sync_at") @db.DateTime(0)
  config                String?                 @db.Text
  createdAt             DateTime                @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt             DateTime                @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  channelProductMapping ChannelProductMapping[]
  orderChannelMapping   OrderChannelMapping[]
  syncLogs              SyncLog[]

  @@index([channelCode], map: "idx_cc_channel")
  @@map("channel_connections")
}

model ChannelProductMapping {
  id               Int               @id @default(autoincrement())
  channelId        Int               @map("channel_id")
  productId        Int               @map("product_id")
  variantId        Int?              @map("variant_id")
  channelProductId String?           @map("channel_product_id") @db.VarChar(100)
  channelSku       String?           @map("channel_sku") @db.VarChar(100)
  channelPrice     Decimal?          @map("channel_price") @db.Decimal(15, 2)
  channelStock     Int?              @map("channel_stock")
  isActive         Boolean           @default(true) @map("is_active")
  lastSyncAt       DateTime?         @map("last_sync_at") @db.DateTime(0)
  createdAt        DateTime          @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  channel          ChannelConnection @relation(fields: [channelId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_cpm_channel")
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_cpm_product")
  variant          ProductVariant?   @relation(fields: [variantId], references: [id], onUpdate: Restrict, map: "fk_cpm_variant")

  @@index([productId], map: "fk_cpm_product")
  @@index([variantId], map: "fk_cpm_variant")
  @@index([channelId], map: "idx_cpm_channel")
  @@map("channel_product_mapping")
}

model CommissionRule {
  id          Int                @id @default(autoincrement())
  name        String             @db.VarChar(255)
  type        CommissionRuleType
  value       Decimal            @db.Decimal(15, 2)
  productId   Int?               @map("product_id")
  categoryId  Int?               @map("category_id")
  minRevenue  Decimal?           @map("min_revenue") @db.Decimal(15, 2)
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at") @db.DateTime(0)
  category    ProductCategory?   @relation(fields: [categoryId], references: [id], onUpdate: Restrict, map: "fk_cr_category")
  product     Product?           @relation(fields: [productId], references: [id], onUpdate: Restrict, map: "fk_cr_product")
  commissions Commission[]

  @@index([categoryId], map: "fk_cr_category")
  @@index([productId], map: "fk_cr_product")
  @@map("commission_rules")
}

model Commission {
  id               Int              @id @default(autoincrement())
  userId           Int              @map("user_id")
  invoiceId        Int?             @map("invoice_id")
  commissionRuleId Int?             @map("commission_rule_id")
  amount           Decimal          @db.Decimal(15, 2)
  status           CommissionStatus @default(pending)
  paidAt           DateTime?        @map("paid_at") @db.DateTime(0)
  notes            String?          @db.Text
  createdAt        DateTime         @default(now()) @map("created_at") @db.DateTime(0)
  invoice          Invoice?         @relation(fields: [invoiceId], references: [id], onUpdate: Restrict, map: "fk_comm_inv")
  commissionRule   CommissionRule?  @relation(fields: [commissionRuleId], references: [id], onUpdate: Restrict, map: "fk_comm_rule")
  user             User             @relation(fields: [userId], references: [id], onUpdate: Restrict, map: "fk_comm_user")

  @@unique([userId, invoiceId, commissionRuleId], map: "uq_commission_line")
  @@index([invoiceId], map: "fk_comm_inv")
  @@index([commissionRuleId], map: "fk_comm_rule")
  @@index([status], map: "idx_comm_status")
  @@index([userId], map: "idx_comm_user")
  @@map("commissions")
}

model CouponCondition {
  id             Int      @id @default(autoincrement())
  couponId       Int      @map("coupon_id")
  conditionType  String   @map("condition_type") @db.VarChar(50)
  conditionValue String   @map("condition_value") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(0)
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_cc_coupon")

  @@index([couponId], map: "idx_cc_coupon")
  @@map("coupon_conditions")
}

model CouponUsage {
  id             Int       @id @default(autoincrement())
  couponId       Int       @map("coupon_id")
  invoiceId      Int?      @map("invoice_id")
  customerId     Int?      @map("customer_id")
  discountAmount Decimal   @map("discount_amount") @db.Decimal(15, 2)
  /// P4.4: personal voucher code used (coupon = its template); null for a plain coupon code
  voucherId      Int?      @map("voucher_id")
  usedAt         DateTime  @default(now()) @map("used_at") @db.DateTime(0)
  coupon         Coupon    @relation(fields: [couponId], references: [id], onUpdate: Restrict, map: "fk_cu_coupon")
  voucher        Voucher?  @relation(fields: [voucherId], references: [id], onUpdate: Restrict, map: "fk_cu_voucher")
  customer       Customer? @relation(fields: [customerId], references: [id], onUpdate: Restrict, map: "fk_cu_customer")
  invoice        Invoice?  @relation(fields: [invoiceId], references: [id], onUpdate: Restrict, map: "fk_cu_invoice")

  @@index([customerId], map: "fk_cu_customer")
  @@index([invoiceId], map: "fk_cu_invoice")
  @@index([couponId], map: "idx_cu_coupon")
  @@index([voucherId], map: "fk_cu_voucher")
  @@map("coupon_usage")
}

model Coupon {
  id                 Int               @id @default(autoincrement())
  code               String            @unique(map: "code") @db.VarChar(100)
  name               String            @db.VarChar(255)
  type               CouponType
  value              Decimal           @db.Decimal(15, 2)
  minOrderAmount     Decimal?          @map("min_order_amount") @db.Decimal(15, 2)
  maxDiscount        Decimal?          @map("max_discount") @db.Decimal(15, 2)
  usageLimit         Int?              @map("usage_limit")
  usagePerCustomer   Int?              @map("usage_per_customer")
  usedCount          Int               @default(0) @map("used_count")
  startDate          DateTime?         @map("start_date") @db.DateTime(0)
  endDate            DateTime?         @map("end_date") @db.DateTime(0)
  applicableChannels String?           @map("applicable_channels") @db.VarChar(255)
  isActive           Boolean           @default(true) @map("is_active")
  createdBy          Int?              @map("created_by")
  createdAt          DateTime          @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  couponConditions   CouponCondition[]
  couponUsage        CouponUsage[]
  createdByUser      User?             @relation(fields: [createdBy], references: [id], onUpdate: Restrict, map: "fk_coupon_created")
  vouchers           Voucher[]

  @@index([createdBy], map: "fk_coupon_created")
  @@index([isActive], map: "idx_coupon_active")
  @@index([code], map: "idx_coupon_code")
  @@index([startDate, endDate], map: "idx_coupon_dates")
  @@map("coupons")
}

model CustomerAddress {
  id         Int      @id @default(autoincrement())
  customerId Int      @map("customer_id")
  address    String   @db.Text
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(0)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_ca_customer")

  @@index([customerId], map: "idx_ca_customer")
  @@map("customer_addresses")
}

model CustomerDebt {
  id              Int                @id @default(autoincrement())
  customerId      Int                @map("customer_id")
  invoiceId       Int?               @map("invoice_id")
  totalAmount     Decimal            @map("total_amount") @db.Decimal(15, 2)
  paidAmount      Decimal            @default(0.00) @map("paid_amount") @db.Decimal(15, 2)
  remainingAmount Decimal            @map("remaining_amount") @db.Decimal(15, 2)
  dueDate         DateTime?          @map("due_date") @db.Date
  status          CustomerDebtStatus @default(pending)
  notes           String?            @db.Text
  createdAt       DateTime           @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  customer        Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_cd_customer")

  @@index([customerId], map: "idx_cd_customer")
  @@index([dueDate], map: "idx_cd_due_date")
  @@index([status], map: "idx_cd_status")
  @@map("customer_debts")
}

model CustomerGroup {
  id              Int        @id @default(autoincrement())
  name            String     @db.VarChar(255)
  code            String     @unique(map: "code") @db.VarChar(50)
  description     String?    @db.Text
  discountPercent Decimal    @default(0.00) @map("discount_percent") @db.Decimal(5, 2)
  isDefault       Boolean    @default(false) @map("is_default")
  createdAt       DateTime   @default(now()) @map("created_at") @db.DateTime(0)
  customers       Customer[]

  @@map("customer_groups")
}

model CustomerLoyaltyPoint {
  id            Int                      @id @default(autoincrement())
  customerId    Int                      @map("customer_id")
  points        Int
  type          CustomerLoyaltyPointType
  referenceType String?                  @map("reference_type") @db.VarChar(50)
  referenceId   Int?                     @map("reference_id")
  notes         String?                  @db.Text
  createdBy     Int?                     @map("created_by")
  createdAt     DateTime                 @default(now()) @map("created_at") @db.DateTime(0)
  createdByUser User?                    @relation(fields: [createdBy], references: [id], onUpdate: Restrict, map: "fk_clp_created")
  customer      Customer                 @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_clp_customer")

  @@index([createdBy], map: "fk_clp_created")
  @@index([createdAt], map: "idx_clp_created")
  @@index([customerId], map: "idx_clp_customer")
  @@map("customer_loyalty_points")
}

model Customer {
  id                    Int                    @id @default(autoincrement())
  code                  String                 @unique(map: "code") @db.VarChar(50)
  fullName              String                 @map("full_name") @db.VarChar(255)
  phone                 String                 @unique(map: "phone") @db.VarChar(20)
  email                 String?                @db.VarChar(255)
  gender                CustomerGender?
  birthday              DateTime?              @db.Date
  groupId               Int?                   @map("group_id")
  ranking               CustomerRanking        @default(silver)
  totalSpent            Decimal                @default(0.00) @map("total_spent") @db.Decimal(15, 2)
  totalPoints           Int                    @default(0) @map("total_points")
  notes                 String?                @db.Text
  debtLimit             Decimal                @default(0.00) @map("debt_limit") @db.Decimal(15, 2)
  isActive              Boolean                @default(true) @map("is_active")
  createdBy             Int?                   @map("created_by")
  createdAt             DateTime               @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  couponUsage           CouponUsage[]
  promotionUsage        PromotionUsage[]
  customerAddresses     CustomerAddress[]
  customerDebts         CustomerDebt[]
  customerLoyaltyPoints CustomerLoyaltyPoint[]
  createdByUser         User?                  @relation(fields: [createdBy], references: [id], onUpdate: Restrict, map: "fk_cust_created")
  group                 CustomerGroup?         @relation(fields: [groupId], references: [id], onUpdate: Restrict, map: "fk_cust_group")
  invoices              Invoice[]
  orders                Order[]
  vouchers              Voucher[]

  @@index([createdBy], map: "fk_cust_created")
  @@index([groupId], map: "fk_cust_group")
  @@index([isActive], map: "idx_cust_active")
  @@index([fullName], map: "idx_cust_name")
  @@index([phone], map: "idx_cust_phone")
  @@index([ranking], map: "idx_cust_ranking")
  @@map("customers")
}

model FlashSaleProduct {
  id               Int             @id @default(autoincrement())
  flashSaleId      Int             @map("flash_sale_id")
  productId        Int             @map("product_id")
  variantId        Int?            @map("variant_id")
  flashPrice       Decimal         @map("flash_price") @db.Decimal(15, 2)
  quantityLimit    Int             @default(0) @map("quantity_limit")
  soldQuantity     Int             @default(0) @map("sold_quantity")
  perCustomerLimit Int             @default(0) @map("per_customer_limit")
  createdAt        DateTime        @default(now()) @map("created_at") @db.DateTime(0)
  product          Product         @relation(fields: [productId], references: [id], onUpdate: Restrict, map: "fk_fsp_product")
  flashSale        FlashSale       @relation(fields: [flashSaleId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_fsp_sale")
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onUpdate: Restrict, map: "fk_fsp_variant")

  @@index([productId], map: "fk_fsp_product")
  @@index([variantId], map: "fk_fsp_variant")
  @@index([flashSaleId], map: "idx_fsp_sale")
  @@map("flash_sale_products")
}

model FlashSale {
  id                Int                @id @default(autoincrement())
  name              String             @db.VarChar(255)
  startTime         DateTime           @map("start_time") @db.DateTime(0)
  endTime           DateTime           @map("end_time") @db.DateTime(0)
  description       String?            @db.Text
  status            FlashSaleStatus    @default(scheduled)
  createdBy         Int?               @map("created_by")
  createdAt         DateTime           @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  flashSaleProducts FlashSaleProduct[]
  createdByUser     User?              @relation(fields: [createdBy], references: [id], onUpdate: Restrict, map: "fk_fs_created")

  @@index([createdBy], map: "fk_fs_created")
  @@index([status], map: "idx_fs_status")
  @@index([startTime, endTime], map: "idx_fs_times")
  @@map("flash_sales")
}

model FundTransaction {
  id            Int                 @id @default(autoincrement())
  fundId        Int                 @map("fund_id")
  type          FundTransactionType
  amount        Decimal             @db.Decimal(15, 2)
  balanceBefore Decimal             @map("balance_before") @db.Decimal(15, 2)
  balanceAfter  Decimal             @map("balance_after") @db.Decimal(15, 2)
  referenceType String?             @map("reference_type") @db.VarChar(50)
  referenceId   Int?                @map("reference_id")
  description   String?             @db.Text
  createdBy     Int?                @map("created_by")
  createdAt     DateTime            @default(now()) @map("created_at") @db.DateTime(0)
  createdByUser User?               @relation(fields: [createdBy], references: [id], onUpdate: Restrict, map: "fk_ft_created")
  fund          CashFund            @relation(fields: [fundId], references: [id], onUpdate: Restrict, map: "fk_ft_fund")

  @@index([createdBy], map: "fk_ft_created")
  @@index([createdAt], map: "idx_ft_created")
  @@index([fundId], map: "idx_ft_fund")
  @@map("fund_transactions")
}

model Inventory {
  id          Int             @id @default(autoincrement())
  productId   Int             @map("product_id")
  warehouseId Int             @map("warehouse_id")
  variantId   Int?            @map("variant_id")
  quantity    Decimal         @default(0.00) @db.Decimal(15, 2)
  minQuantity Int             @default(0) @map("min_quantity")
  maxQuantity Int?            @map("max_quantity")
  createdAt   DateTime        @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_inv_product")
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_inv_variant")
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_inv_warehouse")

  @@unique([productId, warehouseId, variantId], map: "uq_inventory")
  @@index([variantId], map: "fk_inv_variant")
  @@index([productId], map: "idx_inv_product")
  @@index([quantity], map: "idx_inv_quantity")
  @@index([warehouseId], map: "idx_inv_warehouse")
  @@map("inventory")
}

model InventoryBatch {
  id                        Int                        @id @default(autoincrement())
  productId                 Int                        @map("product_id")
  warehouseId               Int                        @map("warehouse_id")
  batchCode                 String                     @map("batch_code") @db.VarChar(100)
  quantity                  Decimal                    @default(0.00) @db.Decimal(15, 2)
  costPrice                 Decimal?                   @map("cost_price") @db.Decimal(15, 2)
  manufactureDate           DateTime?                  @map("manufacture_date") @db.Date
  expiryDate                DateTime?                  @map("expiry_date") @db.Date
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.DateTime(0)
  product                   Product                    @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_ib_product")
  warehouse                 Warehouse                  @relation(fields: [warehouseId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_ib_warehouse")
  inventoryTransactionItems InventoryTransactionItem[]

  @@index([warehouseId], map: "fk_ib_warehouse")
  @@index([expiryDate], map: "idx_ib_expiry")
  @@index([productId, warehouseId], map: "idx_ib_product")
  @@map("inventory_batches")
}

model InventoryTransactionItem {
  id            Int                  @id @default(autoincrement())
  transactionId Int                  @map("transaction_id")
  productId     Int                  @map("product_id")
  variantId     Int?                 @map("variant_id")
  batchId       Int?                 @map("batch_id")
  quantity      Decimal              @db.Decimal(15, 2)
  unitCost      Decimal?             @map("unit_cost") @db.Decimal(15, 2)
  notes         String?              @db.Text
  batch         InventoryBatch?      @relation(fields: [batchId], references: [id], onUpdate: Restrict, map: "fk_iti_batch")
  product       Product              @relation(fields: [productId], references: [id], onUpdate: Restrict, map: "fk_iti_product")
  transaction   InventoryTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_iti_trans")
  variant       ProductVariant?      @relation(fields: [variantId], references: [id], onUpdate: Restrict, map: "fk_iti_variant")

  @@index([batchId], map: "fk_iti_batch")
  @@index([productId], map: "fk_iti_product")
