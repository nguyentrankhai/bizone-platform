  @@map("vouchers")
}

model Warehouse {
  id                                        Int                    @id @default(autoincrement())
  branchId                                  Int?                   @map("branch_id")
  name                                      String                 @db.VarChar(255)
  code                                      String                 @unique(map: "code") @db.VarChar(50)
  address                                   String?                @db.Text
  isActive                                  Boolean                @default(true) @map("is_active")
  createdAt                                 DateTime               @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt                                 DateTime               @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  inventory                                 Inventory[]
  inventoryBatches                          InventoryBatch[]
  inventoryTransactionsDestinationWarehouse InventoryTransaction[] @relation("InventoryTransactionDestinationWarehouse")
  inventoryTransactionsWarehouse            InventoryTransaction[] @relation("InventoryTransactionWarehouse")
  purchaseOrders                            PurchaseOrder[]
  stockTakeNotes                            StockTakeNote[]
  branch                                    Branch?                @relation(fields: [branchId], references: [id], onUpdate: Restrict, map: "fk_wh_branch")

  @@index([branchId], map: "fk_wh_branch")
  @@map("warehouses")
}

