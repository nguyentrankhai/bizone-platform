# Copy to .env.local and fill in values (see documents/env.txt at repo root)

# Database (MariaDB) — host + credentials; the database itself is chosen per tenant
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/bizonedb"
# One database per tenant (SRS-NFR-19): comma list of tenantId=database. Unlisted tenants get 403.
TENANT_DATABASES="tenant_demo=bizonedb"
# Pool size per tenant database (default 5)
# DB_POOL_PER_TENANT=5
# Tenant seeded by `npm run db:seed` (default DEV_TENANT_ID)
# SEED_TENANT_ID=tenant_demo

# Redis
REDIS_URL="redis://:PASSWORD@localhost:6379"

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=bizone

# Dev only — pages call tRPC with these until OIDC login lands (PROGRESS issue #7)
DEV_TENANT_ID=tenant_demo
DEV_AUTH_TOKEN=

# Keycloak (server-side)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=bizone
# Service account (client_credentials) — also manages staff accounts (P4.1): needs the
# realm-management roles view-users, query-users, manage-users + a "client roles" mapper
KEYCLOAK_CLIENT_ID=bizone-api
KEYCLOAK_CLIENT_SECRET=
# Clients whose tokens are accepted (azp); default bizone-frontend,bizone-api
# KEYCLOAK_ALLOWED_CLIENTS=bizone-frontend,bizone-api

# Keycloak (browser)
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=bizone
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=bizone-frontend

# App
APP_URL=http://localhost:3000

# POS realtime (process dist/pos.mjs / npm run dev:realtime)
POS_WS_PORT=3002
# Browser URL of the POS WebSocket (default ws://<page host>:3002)
# NEXT_PUBLIC_POS_WS_URL=ws://localhost:3002

# Payment Hub
PAYHUB_API_URL=http://localhost:4000/api
PAYHUB_API_KEY=
PAYHUB_API_SECRET=
# Secret of the Payment Hub webhook endpoint pointing at /api/webhooks/payhub (shown once on create)
PAYHUB_WEBHOOK_SECRET=

# docker compose overrides (optional)
# APP_PORT=3000
# DB_PASSWORD=
# DB_HOST_PORT=3307
# REDIS_PASSWORD=
# REDIS_HOST_PORT=6380
