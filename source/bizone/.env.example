# Copy to .env.local and fill in values (see documents/env.txt at repo root)

# Database (MariaDB) — host + credentials; the database itself is chosen per tenant
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/bizonedb"
# One database per tenant (SRS-NFR-19): comma list of tenantId=database. Unlisted tenants get 403.
TENANT_DATABASES="tenant_demo=bizonedb"
# Pool size per tenant database (default 5)
# DB_POOL_PER_TENANT=5
# Tenant seeded by `npm run db:seed` (default DEV_TENANT_ID)
# SEED_TENANT_ID=tenant_demo

# Redis
REDIS_URL="redis://:PASSWORD@localhost:6379"

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=bizone

# Default tenant for `npm run db:seed` when SEED_TENANT_ID is unset. Pages get the tenant from
# the signed-in user's `tenant_id` claim (Keycloak login, P6.7) — there is no login bypass.
DEV_TENANT_ID=tenant_demo

# QA-3 (#97): set true only behind a reverse proxy that sets X-Real-IP / appends X-Forwarded-For —
# then per-IP rate limits (display pairing PIN) use that address; otherwise all clients share one bucket
TRUST_PROXY=false

# Keycloak (server-side)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=bizone
# Service account (client_credentials) — also manages staff accounts (P4.1): needs the
# realm-management roles view-users, query-users, manage-users + a "client roles" mapper
KEYCLOAK_CLIENT_ID=bizone-api
KEYCLOAK_CLIENT_SECRET=
# Clients whose tokens are accepted (azp); default bizone-frontend,bizone-api
# KEYCLOAK_ALLOWED_CLIENTS=bizone-frontend,bizone-api

# Keycloak (browser sign-in, P6.7: Authorization Code + PKCE, public client). Build-time values;
# the client needs this app's origin in Valid redirect URIs (/auth/callback) + Web origins.
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=bizone
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=bizone-frontend

# App
APP_URL=http://localhost:3000

# POS realtime (process dist/pos.mjs / npm run dev:realtime)
POS_WS_PORT=3002
# Browser URL of the POS WebSocket (default ws://<page host>:3002)
# NEXT_PUBLIC_POS_WS_URL=ws://localhost:3002

# Payment Hub
PAYHUB_API_URL=http://localhost:4000/api
PAYHUB_API_KEY=
PAYHUB_API_SECRET=
# P4.5 POS card / QR through Payment Hub: route methods used (Payment Hub routeMap.ts)
PAYHUB_QR_METHOD=vietqr
PAYHUB_CARD_METHOD=vnpay_card
# Secret of the Payment Hub webhook endpoint pointing at /api/webhooks/payhub (shown once on create)
PAYHUB_WEBHOOK_SECRET=

# P4.7 Notifications — email (SMTP). No SMTP_HOST → "log" provider (printed, recorded as sent)
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); default: port === 465
# SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="BizOne <no-reply@example.com>"
# SMS: "log" (default, dev) or "http" — POST SMS_GATEWAY_URL {to, message, brandname} + Bearer token
SMS_PROVIDER=log
# P6.1 website registration: dev only — return the SMS one-time code to the storefront when
# SMS_PROVIDER=log (no real SMS). Never set in production.
STORE_OTP_DEV_ECHO=false
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_BRANDNAME=
# true = keep Vietnamese accents in SMS (UCS-2, 70 chars/segment); default strips them
# SMS_UNICODE=false
# Web Push (VAPID) — generate once: npx web-push generate-vapid-keys. Empty = push disabled
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# docker compose overrides (optional)
# APP_PORT=3000
# DB_PASSWORD=
# DB_HOST_PORT=3307
# REDIS_PASSWORD=
# REDIS_HOST_PORT=6380

# P6.2/P6.3 Omni Channel — Shopee / Lazada / TikTok Shop / Facebook (BizOne's own apps on the platforms; each shop authorizes via OAuth)
# OMNI_TOKEN_KEY: base64 32 bytes (openssl rand -base64 32) — encrypts shop tokens; never change after shops connect
OMNI_TOKEN_KEY=
# Shopee Open Platform v2: partner id / key; API host (sandbox: https://partner.test-stable.shopeemobile.com,
# live: https://partner.shopeemobile.com); push URL as registered on the Shopee console (part of the push signature)
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_API_URL=https://partner.test-stable.shopeemobile.com
# SHOPEE_PUSH_URL=https://bizone.example.com/api/webhooks/shopee
# Lazada Open Platform: app key / secret; Vietnam gateway; auth host (authorize page + token APIs)
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_API_URL=https://api.lazada.vn/rest
LAZADA_AUTH_URL=https://auth.lazada.com
# P6.3 TikTok Shop Partner Center app (API 202309): app key / secret, service id (authorize link);
# redirect URL {APP_URL}/api/omni/oauth/tiktok/callback and webhook {APP_URL}/api/webhooks/tiktok are set on the Partner Center
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SERVICE_ID=
# TIKTOK_API_URL=https://open-api.tiktokglobalshop.com
# TIKTOK_AUTH_API_URL=https://auth.tiktok-shops.com
# TIKTOK_AUTHORIZE_URL=https://services.tiktokshop.com/open/authorize
# P6.3 Facebook / Instagram (Meta app with Facebook Login for Business; scopes catalog_management, business_management;
# valid OAuth redirect URI {APP_URL}/api/omni/oauth/facebook/callback). Catalog links point to the website channel.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# FACEBOOK_GRAPH_URL=https://graph.facebook.com/v21.0
# FACEBOOK_OAUTH_URL=https://www.facebook.com/v21.0/dialog/oauth
# Sync cadence (ms): price / stock push, order polling
# OMNI_STOCK_SYNC_MS=10000
# OMNI_ORDER_POLL_MS=120000
