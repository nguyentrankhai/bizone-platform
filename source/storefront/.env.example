# BizOne storefront (P6.1) — copy to .env.local
# BizOne store API (server-to-server, never exposed to the browser)
BIZONE_API_URL=http://localhost:3000/api/store/v1
# Store keys per sub-domain: slug=key (key from BizOne → Omni Channel → Website → "Tạo khoá")
STORE_KEYS="demo=bzs.tenant_demo.replace-with-store-key"
# Store served when the host has no known sub-domain (localhost)
DEFAULT_STORE=demo
# Public base URL of this site. The default store (no sub-domain) uses it as is; a store reached
# on {slug}.{STORE_ROOT_DOMAIN} uses that origin with this scheme / port (QA-5 #156). The Payment
# Hub return URL is built from it, so it must match "Địa chỉ website" of each store in BizOne.
STOREFRONT_URL=http://localhost:3100
# Root domain of store sub-domains ({slug}.bizone.vn)
STORE_ROOT_DOMAIN=bizone.vn
# P6.6 — Payment Hub origin: allowed as a form target (checkout redirect without JavaScript, CSP form-action)
PAYMENT_HUB_URL=http://localhost:4000
# P6.6 — production behind TLS: redirect http → https (+ HSTS); trust X-Forwarded-* from the reverse proxy
FORCE_HTTPS=false
TRUST_PROXY=false
# P6.6 — extra origins allowed as form targets (comma-separated; Payment Hub is already allowed)
CSP_FORM_ACTION=
# Cookies are `Secure` in production; set true only to test a production build over plain http
COOKIE_INSECURE=false
