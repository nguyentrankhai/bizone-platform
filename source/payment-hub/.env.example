# Copy to .env.local and fill in values (see documents/env.txt at repo root)

# Database (MariaDB) — paymentdb
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/paymentdb"

# Redis (cache, BullMQ queues, realtime pub/sub)
REDIS_URL="redis://:PASSWORD@localhost:6379"

# Realtime WebSocket server (server/ws/server.ts)
WS_PORT=4001
NEXT_PUBLIC_WS_URL=ws://localhost:4001/ws

# Keycloak — realm payment-hub
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=payment-hub
KEYCLOAK_CLIENT_ID=payhub-api
KEYCLOAK_CLIENT_SECRET=
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=payment-hub
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=payhub-admin-console

# App
APP_URL=http://localhost:4000

# docker compose overrides (optional)
# APP_PORT=4000
# WS_HOST_PORT=4001
# DB_PASSWORD=
# DB_HOST_PORT=3308
# REDIS_PASSWORD=
# REDIS_HOST_PORT=6381
