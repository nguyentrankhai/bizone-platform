# Copy to .env.local and fill in values (see documents/env.txt at repo root)

# Database (MariaDB) — paymentdb
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/paymentdb"

# Redis (cache, BullMQ queues, realtime pub/sub)
REDIS_URL="redis://:PASSWORD@localhost:6379"

# Realtime WebSocket server (server/ws/server.ts)
WS_PORT=4001
NEXT_PUBLIC_WS_URL=ws://localhost:4001/ws

# Keycloak — realm payment-hub
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=payment-hub
KEYCLOAK_CLIENT_ID=payhub-api
KEYCLOAK_CLIENT_SECRET=
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=payment-hub
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=payhub-admin-console

# App
APP_URL=http://localhost:4000

# AES-256-GCM key for partner secrets stored in partner_configs (openssl rand -base64 32)
PARTNER_ENCRYPTION_KEY=

# VNPay sandbox (used by `npm run db:seed` to create the encrypted partner config)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# VietQR (P3.4) — bank account that receives transfers; `npm run db:seed` stores it as the
# encrypted partner config (connector_type VietQR). QR_EXPIRES_SECONDS = default QR lifetime.
VIETQR_BANK_BIN=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
# Partner config name created by the seed (default "VietQR")
# VIETQR_CONFIG_NAME=VietQR
QR_EXPIRES_SECONDS=900

# MoMo (P5.1) — `npm run db:seed` creates an Inactive "MoMo Sandbox" partner config (encrypted);
# test + activate it on /partners. MOMO_API_URL = API base (…/v2/gateway/api). The IPN URL sent to
# MoMo is the partner config's webhook URL (default {APP_URL}/api/ipn/momo) — must be public.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_API_URL=https://test-payment.momo.vn/v2/gateway/api
# ZaloPay (P5.2) — `npm run db:seed` creates an Inactive "ZaloPay Sandbox" partner config
# (app_id → merchant code, key1 signs requests, key2 verifies callbacks; keys encrypted). The
# callback_url sent with each order is the partner config's webhook URL (default
# {APP_URL}/api/ipn/zalopay) — must be public. ZALOPAY_API_URL = API base (…/v2).
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_API_URL=https://sb-openapi.zalopay.vn/v2
# Worker: query the PSP for Pending MoMo / ZaloPay transactions whose IPN is overdue (defaults shown)
# PAYMENT_STATUS_SYNC_AFTER_S=60
# PAYMENT_STATUS_SYNC_BATCH=20

# Refunds (P5.3): days after payment a refund may be requested (default 30 — confirm with each PSP
# contract); worker polling of asynchronous refunds (ZaloPay query_refund), defaults shown
# REFUND_WINDOW_DAYS=30
# REFUND_STATUS_SYNC_BATCH=20
# REFUND_STATUS_SYNC_MAX_DAYS=7

# Reconciliation (P5.4): daily job (cron, Vietnam time) and parallel PSP status queries per run;
# PDF export reads pdfmake's Roboto fonts from ./node_modules (override with PDF_FONT_DIR)
# RECON_DAILY_CRON=0 0 * * *
# RECON_API_CONCURRENCY=8
# PDF_FONT_DIR=

# Disputes (P5.6) — evidence file storage: S3 / MinIO when S3_ENDPOINT is set (bucket created on
# first upload), otherwise a local directory (STORAGE_LOCAL_DIR, default ./storage — single instance
# only; mount a volume in Docker). STORAGE_DRIVER=s3|local forces the driver.
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=payment-hub
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# STORAGE_LOCAL_DIR=./storage
# STORAGE_DRIVER=
# E-mail (disputes sent to partner_configs.dispute_email + result notifications): SMTP when
# SMTP_HOST is set, otherwise messages are only printed by the server ("log" provider).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="Payment Hub <no-reply@payhub.local>"
# Operations mailbox: CC of every partner dispute e-mail + receives every dispute result
# DISPUTE_NOTIFY_EMAILS=
# Reply-To of partner dispute e-mails (partners answer there)
# DISPUTE_REPLY_TO=

# Webhooks (P3.6): only for dev — allows delivery to localhost/private IPs. Leave unset in production.
# WEBHOOK_ALLOW_PRIVATE_NETWORKS=true

# Route Engine (P3.8): circuit breaker per partner config — open after N consecutive failures
# within the window, skip the partner for OPEN_S seconds (defaults shown).
# ROUTE_CB_FAILURES=5
# ROUTE_CB_WINDOW_S=60
# ROUTE_CB_OPEN_S=30

# Public base URL used in payment_url when no method is chosen (baked in at build time — #37)
NEXT_PUBLIC_APP_URL=http://localhost:4000
# Keycloak clients whose tokens the admin API accepts (default: payhub-admin-console,payhub-api)
# KEYCLOAK_ALLOWED_CLIENTS=payhub-admin-console,payhub-api
# NAPAS bank list used by the partner form (default: https://api.vietqr.io/v2/banks)
# VIETQR_BANKS_URL=https://api.vietqr.io/v2/banks

# docker compose overrides (optional)
# APP_PORT=4000
# WS_HOST_PORT=4001
# DB_PASSWORD=
# DB_HOST_PORT=3308
# REDIS_PASSWORD=
# REDIS_HOST_PORT=6381

# Dev only — Keycloak access token (realm payment-hub, role payhub-admin/viewer) used by admin
# pages to call /api/internal/* until OIDC login is wired. Expires after 15 minutes.
DEV_AUTH_TOKEN=

# Dev only (P4.0, removed with P6.7) — skip Keycloak login: admin requests WITHOUT a token
# (/api/internal/*, realtime WebSocket) run as the dev user below; a real token is still
# verified. Merchant API (X-Api-Key + HMAC) and IPN are unaffected. NEVER enable in production.
AUTH_DEV_BYPASS=false
# AUTH_DEV_USER=payhub.admin@bizone.vn
# AUTH_DEV_ROLES=payhub-admin
# AUTH_DEV_MERCHANT_ID=
