# Copy to .env.local and fill in values (see documents/env.txt at repo root)

# Database (MariaDB) — paymentdb
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/paymentdb"

# Redis (cache, BullMQ queues, realtime pub/sub)
REDIS_URL="redis://:PASSWORD@localhost:6379"

# ─── Scale (P7.4) ───────────────────────────────────────────────────────────────
# Redis Cluster: seed nodes host:port,… (credentials from REDIS_URL or REDIS_PASSWORD). Empty = the
# single server of REDIS_URL. BullMQ keys then use the hash-tagged prefix "{payhub}" (QUEUE_PREFIX
# overrides; default "bull" on a single server) — drain the queues before switching.
REDIS_CLUSTER_NODES=
# QUEUE_PREFIX=
# MariaDB pool per process (instances × size < max_connections)
DB_POOL_SIZE=10
# DB_ACQUIRE_TIMEOUT_MS=5000
# Worker instances: queues consumed by this instance (webhook,recon,dispute,notification,maintenance
# or all) and parallel jobs per queue. Periodic jobs (outbox sweep, expiry, health, retention,
# archive) run once per tick for the whole deployment whatever the number of workers.
WORKER_QUEUES=all
# WORKER_CONCURRENCY_WEBHOOK=20
# WORKER_CONCURRENCY_RECON=1
# WORKER_CONCURRENCY_DISPUTE=2
# WORKER_CONCURRENCY_NOTIFICATION=4
# WORKER_LOG_DELIVERIES=true
# Webhook outbox sweep: rows per batch, parallel dispatches, time budget per 30 s tick
# OUTBOX_SWEEP_BATCH=500
# OUTBOX_SWEEP_CONCURRENCY=20
# OUTBOX_SWEEP_BUDGET_MS=25000
# Merchant API key lookups cached per process (ms, 0 = off) — a revoked key works ≤ this long
# API_KEY_CACHE_TTL_MS=10000
# Transaction list cache in Redis (s, 0 = off) — invalidated by every transaction event
# TXN_LIST_CACHE_TTL_S=5
# Archive (scripts/partition-transactions.sql): final transactions older than N months move to the
# partitioned transactions_archive every night (0 = off, ≥ 13); archive months older than
# RETENTION are dropped (0 = keep forever)
TXN_ARCHIVE_MONTHS=24
TXN_ARCHIVE_RETENTION_MONTHS=0
# TXN_ARCHIVE_CRON="45 2 * * *"
# TXN_ARCHIVE_BATCH=500
# TXN_ARCHIVE_MAX_PER_RUN=200000

# Realtime WebSocket server (server/ws/server.ts)
WS_PORT=4001
NEXT_PUBLIC_WS_URL=ws://localhost:4001/ws

# Keycloak — realm payment-hub
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=payment-hub
KEYCLOAK_CLIENT_ID=payhub-api
KEYCLOAK_CLIENT_SECRET=
# Admin console sign-in (P6.7: Authorization Code + PKCE, public client). Build-time values;
# the client needs this app's origin in Valid redirect URIs (/auth/callback) + Web origins.
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=payment-hub
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=payhub-admin-console

# App
APP_URL=http://localhost:4000

# AES-256-GCM key for partner secrets stored in partner_configs (openssl rand -base64 32)
PARTNER_ENCRYPTION_KEY=

# VNPay sandbox (used by `npm run db:seed` to create the encrypted partner config)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# VietQR (P3.4) — bank account that receives transfers; `npm run db:seed` stores it as the
# encrypted partner config (connector_type VietQR). QR_EXPIRES_SECONDS = default QR lifetime.
VIETQR_BANK_BIN=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
# Partner config name created by the seed (default "VietQR")
# VIETQR_CONFIG_NAME=VietQR
QR_EXPIRES_SECONDS=900

# MoMo (P5.1) — `npm run db:seed` creates an Inactive "MoMo Sandbox" partner config (encrypted);
# test + activate it on /partners. MOMO_API_URL = API base (…/v2/gateway/api). The IPN URL sent to
# MoMo is the partner config's webhook URL (default {APP_URL}/api/ipn/momo) — must be public.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_API_URL=https://test-payment.momo.vn/v2/gateway/api
# ZaloPay (P5.2) — `npm run db:seed` creates an Inactive "ZaloPay Sandbox" partner config
# (app_id → merchant code, key1 signs requests, key2 verifies callbacks; keys encrypted). The
# callback_url sent with each order is the partner config's webhook URL (default
# {APP_URL}/api/ipn/zalopay) — must be public. ZALOPAY_API_URL = API base (…/v2).
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_API_URL=https://sb-openapi.zalopay.vn/v2
# Worker: query the PSP for Pending MoMo / ZaloPay transactions whose IPN is overdue (defaults shown)
# PAYMENT_STATUS_SYNC_AFTER_S=60
# PAYMENT_STATUS_SYNC_BATCH=20

# Refunds (P5.3): days after payment a refund may be requested (default 30 — confirm with each PSP
# contract); worker polling of asynchronous refunds (ZaloPay query_refund), defaults shown
# REFUND_WINDOW_DAYS=30
# REFUND_STATUS_SYNC_BATCH=20
# REFUND_STATUS_SYNC_MAX_DAYS=7

# Connector plugins (P7.1): Ed25519 public keys of trusted plugin publishers — an upload must be
# signed by one of them ("keyId=<base64 SPKI DER>,keyId2=…"; `node scripts/connector-plugin.mjs
# keygen <keyId>` prints an entry). Empty = no plugin can be installed / loaded.
CONNECTOR_TRUSTED_KEYS=
# Optional: where each process extracts plugin packages (default <tmp>/payhub-connectors),
# sandbox heap per plugin (MB), Health Monitor period (s), latency above which health = Degraded (ms)
# CONNECTOR_PLUGIN_DIR=
# CONNECTOR_SANDBOX_MAX_HEAP_MB=128
# CONNECTOR_HEALTH_INTERVAL_S=300
# CONNECTOR_DEGRADED_LATENCY_MS=5000

# Audit log (P7.2): days audit_logs are kept before the worker purges them (minimum and default 90 —
# the DB refuses to delete younger rows)
# AUDIT_RETENTION_DAYS=90

# Notifications (P7.3): default e-mail recipients of alerts (webhook failures, reconciliation
# discrepancies, partner connection errors…) — set it on the app AND the worker (both emit events);
# per-event recipients / thresholds are edited at /notifications → Cấu hình. Falls back to
# DISPUTE_NOTIFY_EMAILS. E-mails go through SMTP_* (empty = written to the log only).
NOTIFY_EMAILS=

# Reconciliation (P5.4): daily job (cron, Vietnam time) and parallel PSP status queries per run;
# PDF export reads pdfmake's Roboto fonts from ./node_modules (override with PDF_FONT_DIR)
# RECON_DAILY_CRON=0 0 * * *
# RECON_API_CONCURRENCY=8
# PDF_FONT_DIR=

# Disputes (P5.6) — evidence file storage: S3 / MinIO when S3_ENDPOINT is set (bucket created on
# first upload), otherwise a local directory (STORAGE_LOCAL_DIR, default ./storage — single instance
# only; mount a volume in Docker). STORAGE_DRIVER=s3|local forces the driver.
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=payment-hub
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# STORAGE_LOCAL_DIR=./storage
# STORAGE_DRIVER=
# E-mail (disputes sent to partner_configs.dispute_email + result notifications): SMTP when
# SMTP_HOST is set, otherwise messages are only printed by the server ("log" provider).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="Payment Hub <no-reply@payhub.local>"
# Operations mailbox: CC of every partner dispute e-mail + receives every dispute result
# DISPUTE_NOTIFY_EMAILS=
# Reply-To of partner dispute e-mails (partners answer there)
# DISPUTE_REPLY_TO=

# Webhooks (P3.6): only for dev — allows delivery to localhost/private IPs. Leave unset in production.
# WEBHOOK_ALLOW_PRIVATE_NETWORKS=true

# Route Engine (P3.8): circuit breaker per partner config — open after N consecutive failures
# within the window, skip the partner for OPEN_S seconds (defaults shown).
# ROUTE_CB_FAILURES=5
# ROUTE_CB_WINDOW_S=60
# ROUTE_CB_OPEN_S=30

# QA-4 (#125): set true only behind a reverse proxy that sets X-Real-IP / appends X-Forwarded-For —
# then the client IP (logs, VNPay vnp_IpAddr, rate limits) comes from it; otherwise it is unknown
TRUST_PROXY=false

# P6.6 — security hardening (proxy.ts, lib/security/http.ts)
# TRUST_PROXY=true also: X-Forwarded-Proto / X-Forwarded-Host decide https + host; per-IP lockouts
# (forged bearer tokens, wrong API key / signature) only apply when the client IP is known
# Production behind TLS: redirect plain http → https (308) and send HSTS
FORCE_HTTPS=false
# Other sites allowed to call this API from a browser (CORS), space/comma separated origins.
# Empty = same-origin only; cross-site POST/PUT/PATCH/DELETE from any other origin → 403
CORS_ALLOWED_ORIGINS=
# Extra origins for CSP connect-src (besides self, NEXT_PUBLIC_KEYCLOAK_URL and the realtime WebSocket)
CSP_CONNECT_SRC=
# Longest access-token lifetime of the realm (seconds): sessions ended in Keycloak (back-channel logout) are
# refused for this long — back-channel URL: {APP_URL}/api/auth/backchannel-logout
ACCESS_TOKEN_MAX_SECONDS=1800

# Public base URL used in payment_url when no method is chosen (baked in at build time — #37)
NEXT_PUBLIC_APP_URL=http://localhost:4000
# Keycloak clients whose tokens the admin API accepts (default: payhub-admin-console,payhub-api)
# KEYCLOAK_ALLOWED_CLIENTS=payhub-admin-console,payhub-api
# NAPAS bank list used by the partner form (default: https://api.vietqr.io/v2/banks)
# VIETQR_BANKS_URL=https://api.vietqr.io/v2/banks

# docker compose overrides (optional)
# APP_PORT=4000
# WS_HOST_PORT=4001
# DB_PASSWORD=
# DB_HOST_PORT=3308
# REDIS_PASSWORD=
# REDIS_HOST_PORT=6381
